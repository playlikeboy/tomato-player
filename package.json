{
  "name": "tomato-player-monorepo",
  "private": true,
  "description": "Tomato Player — one player, a thousand possibilities.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" build",
    "dev": "pnpm -r --parallel --filter \"./packages/**\" dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --filter \"./packages/**\" typecheck",
    "validate": "node scripts/validate-extensions.mjs",
    "size": "node scripts/size.mjs",
    "new": "node scripts/new.mjs",
    "playground": "pnpm build && node scripts/serve.mjs",
    "docs:llms": "node scripts/build-llms.mjs",
    "check": "pnpm build && pnpm typecheck && pnpm test && pnpm validate && pnpm size",
    "site": "node scripts/build-site.mjs",
    "site:dev": "SITE_BASE=/site-dist/ node scripts/build-site.mjs && node scripts/serve.mjs"
  },
  "devDependencies": {
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^20.0.0",
    "marked": "^15",
    "react": "^19.0.0",
    "react-dom": "^19.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^3.0.0"
  }
}
