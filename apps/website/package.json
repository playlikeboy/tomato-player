{
  "name": "@tomato-player/website",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/prepare.mjs",
    "dev": "next dev --webpack",
    "prebuild": "node scripts/prepare.mjs",
    "build": "next build --webpack && pagefind --site out --output-subdir _pagefind",
    "typecheck": "tsc --noEmit",
    "serve": "node ../../scripts/serve.mjs"
  },
  "dependencies": {
    "@astryxdesign/core": "0.7.17",
    "@astryxdesign/theme-neutral": "0.7.17",
    "@fontsource/geist-sans": "^5.3.0",
    "@stylexjs/stylex": "0.19",
    "@tomato-player/core": "workspace:*",
    "@tomato-player/plugin-analytics": "workspace:*",
    "@tomato-player/plugin-chapters": "workspace:*",
    "@tomato-player/plugin-gestures": "workspace:*",
    "@tomato-player/plugin-hotkeys": "workspace:*",
    "@tomato-player/plugin-media-session": "workspace:*",
    "@tomato-player/plugin-persist": "workspace:*",
    "@tomato-player/plugin-playlist": "workspace:*",
    "@tomato-player/plugin-thumbnails": "workspace:*",
    "@tomato-player/provider-dash": "workspace:*",
    "@tomato-player/provider-hls": "workspace:*",
    "@tomato-player/react": "workspace:*",
    "@tomato-player/skin-campus": "workspace:*",
    "@tomato-player/skin-cinema": "workspace:*",
    "@tomato-player/skin-creator": "workspace:*",
    "@tomato-player/skin-feed": "workspace:*",
    "@tomato-player/skin-learn": "workspace:*",
    "@tomato-player/skin-minimal": "workspace:*",
    "@tomato-player/skin-stream": "workspace:*",
    "@tomato-player/skin-studio": "workspace:*",
    "@tomato-player/skin-tube": "workspace:*",
    "@tomato-player/ui": "workspace:*",
    "dashjs": "^4.7.0",
    "hls.js": "^1.6.0",
    "next": "16",
    "react": "19",
    "react-dom": "19",
    "tomato-player": "workspace:*"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.7.17",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.3.0",
    "pagefind": "^1.6.0",
    "typescript": "^5.6.3"
  },
  "description": "Tomato Player website: landing, docs, skin gallery, demos and playground. Built with Next.js and the Astryx design system."
}
