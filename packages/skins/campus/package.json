{
  "name": "@tomato-player/skin-campus",
  "version": "0.1.0",
  "description": "CampusLoop's paper-sticker skin: sticker control strip, sticker captions, tap-to-unmute.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --minify --loader .css=text && cp src/style.css dist/style.css",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@tomato-player/core": "workspace:*",
    "@tomato-player/ui": "workspace:*"
  },
  "keywords": [
    "tomato-player",
    "tomato-player-skin",
    "video",
    "player"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/playlikeboy/tomato-player",
    "directory": "packages/skins/campus"
  },
  "tomato": {
    "kind": "skin"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "playlikeboy",
  "homepage": "https://playlikeboy.github.io/tomato-player/",
  "bugs": "https://github.com/playlikeboy/tomato-player/issues"
}
