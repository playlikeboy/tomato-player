{
  "name": "@tomato-player/svelte",
  "version": "0.1.0",
  "description": "Svelte action and store for Tomato Player (Svelte 4 and 5, SvelteKit SSR-safe).",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "svelte": "./dist/index.js", "import": "./dist/index.js", "require": "./dist/index.cjs" } },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --minify",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": { "@tomato-player/core": "workspace:*" },
  "peerDependencies": { "svelte": ">=4" },
  "peerDependenciesMeta": { "svelte": { "optional": true } },
  "repository": { "type": "git", "url": "https://github.com/playlikeboy/tomato-player", "directory": "packages/integrations/svelte" },
  "tomato": { "kind": "integration" }
}
