{
  "name": "@tomato-player/react",
  "version": "0.1.0",
  "description": "React bindings for Tomato Player. SSR-safe, React 18/19, Strict Mode friendly.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --minify --external react && node ../../../scripts/use-client.mjs dist",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@tomato-player/core": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@tomato-player/ui": "workspace:^",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19",
    "react": "^19.0.0",
    "react-dom": "^19"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/playlikeboy/tomato-player",
    "directory": "packages/integrations/react"
  },
  "tomato": {
    "kind": "integration"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "playlikeboy",
  "homepage": "https://playlikeboy.github.io/tomato-player/",
  "bugs": "https://github.com/playlikeboy/tomato-player/issues"
}
