{
  "name": "@tomato-player/plugin-hotkeys",
  "version": "0.1.0",
  "description": "Keyboard shortcuts for Tomato Player (YouTube-style defaults, fully remappable).",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --minify",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@tomato-player/core": "workspace:*"
  },
  "keywords": [
    "tomato-player",
    "tomato-player-plugin",
    "video",
    "player"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/playlikeboy/tomato-player",
    "directory": "packages/plugins/hotkeys"
  },
  "tomato": {
    "kind": "plugin"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "playlikeboy",
  "homepage": "https://playlikeboy.github.io/tomato-player/",
  "bugs": "https://github.com/playlikeboy/tomato-player/issues"
}
