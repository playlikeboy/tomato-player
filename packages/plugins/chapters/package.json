{
  "name": "@tomato-player/plugin-chapters",
  "version": "0.1.0",
  "description": "Chapters for Tomato Player from arrays or WebVTT, with seek-bar markers.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --minify",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@tomato-player/core": "workspace:*"
  },
  "keywords": [
    "tomato-player",
    "tomato-player-plugin",
    "video",
    "player"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/playlikeboy/tomato-player",
    "directory": "packages/plugins/chapters"
  },
  "tomato": {
    "kind": "plugin"
  }
}
